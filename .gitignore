# Quarto's output and its working files
/_site/
/.quarto/
/_axe-checks/
**/*.quarto_ipynb

# Python
/.venv/
__pycache__/

# API keys for running evaluations; Inspect reads this file itself
.env

# A note's trial runs, and the files the build makes from its logs
notes/*/smoke-logs/
notes/*/_results.yml
notes/*/_table-*.md
notes/*/_chart.md

# The Library's pages, built from its entries before every render (scripts/library.py build), and the
# papers its searches fetch to be read, which are others' words and never committed
library/_*.md
library/*/_*.md
library/*/_area.yml
library/.cache/

.DS_Store
